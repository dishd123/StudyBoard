{
  "name": "studyboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "gcp-build": "npm ci --prefix frontend --include=dev && npm run build && npm ci --prefix backend --omit=dev",
    "start": "node backend/server.js",
    "dev": "npm --prefix frontend run dev --",
    "build": "npm --prefix frontend run build --",
    "preview": "npm --prefix frontend run preview --",
    "check": "npm --prefix frontend run check --",
    "test:frontend": "npm --prefix frontend run test:frontend --"
  }
}
