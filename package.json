{
  "name": "studyboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "gcp-build": "npm ci --prefix frontend --include=dev && npm run build && npm ci --prefix backend --omit=dev",
    "build": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev"
  }
}