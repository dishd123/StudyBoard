{
  "name": "studyboard-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:photo": "node --env-file-if-exists=.env scripts/testGeminiPhoto.js",
    "test:audio": "node --env-file-if-exists=.env scripts/testGeminiAudio.js",
    "test:agents": "node --env-file-if-exists=.env scripts/testAgents.js"
  },
  "dependencies": {
    "@google/adk": "2.5.0",
    "@google/genai": "3.3.0",
    "express": "5.3.0",
    "firebase-admin": "14.5.1",
    "zod": "4.6.7"
  }
}