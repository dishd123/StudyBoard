# StudyBoard backend settings for local runs (issue #17). Copy this file to backend/.env, which git ignores.
# npm run dev loads backend/.env. On Cloud Run these come from --set-env-vars and --set-secrets instead.

# Local port; the Vite proxy sends /api here.
# Do not set K_SERVICE locally: it makes the server listen on every network interface, as on Cloud Run.
PORT=8080

# Project that holds Firebase Authentication and Firestore.
# Firestore uses your own Google login locally: run `gcloud auth application-default login` once.
GOOGLE_CLOUD_PROJECT=gen-lang-client-0800605818

# Gemini Developer API key from Google AI Studio. Left empty, every AI route answers 503.
# Never add GOOGLE_API_KEY or GOOGLE_GENAI_API_KEY: both SDKs read those before GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Analytics 4 Measurement Protocol. Leave both empty to keep server analytics off.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Model calls each signed-in user may make per hour.
MODEL_CALLS_PER_HOUR=30