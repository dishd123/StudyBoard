# Server-only backend configuration.
# Never commit populated copies of this file or service-account credentials.

# Express runtime
PORT=8080
NODE_ENV=development

# Gemini model services
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_AUDIO_MODEL=gemini-3.8-flash

# Firebase Admin configuration. Prefer the deployment platform's secret
# manager or application-default credentials instead of storing a private key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# GA4 Measurement Protocol (server-only)
GA4_MEASUREMENT_ID=G-EXAMPLE
GA4_API_SECRET=your-ga4-api-secret
ANALYTICS_ENABLED=false
