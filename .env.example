# StudyBoard environment reference
#
# Copy the relevant sections to a local, ignored file:
#   cp frontend/.env.example frontend/.env.local
#   cp backend/.env.example backend/.env
#
# Values in this file are placeholders only. Never commit a populated .env file,
# Firebase service-account JSON, private key, or API secret.

# ---------------------------------------------------------------------------
# Frontend: browser-visible Vite variables
# ---------------------------------------------------------------------------
# Only variables prefixed with VITE_ may be exposed to the browser bundle.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GA4_MEASUREMENT_ID=G-EXAMPLE
VITE_ANALYTICS_ENABLED=false

# ---------------------------------------------------------------------------
# Backend: server-only variables
# ---------------------------------------------------------------------------
# These values must not use the VITE_ prefix and must not be sent to clients.
PORT=8080
NODE_ENV=development
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_AUDIO_MODEL=gemini-3.8-flash
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
GA4_MEASUREMENT_ID=G-EXAMPLE
GA4_API_SECRET=your-ga4-api-secret
ANALYTICS_ENABLED=false
