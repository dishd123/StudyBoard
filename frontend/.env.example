# Browser-visible frontend configuration.
# Vite embeds VITE_* values in the browser bundle, so do not put secrets here.
#
# Replace every placeholder with a value from the Firebase web app, Google
# OAuth consent configuration, or GA4 web stream before enabling those features.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GA4_MEASUREMENT_ID=G-EXAMPLE

# Collection is opt-in. Keep false until analytics is configured and wired.
VITE_ANALYTICS_ENABLED=false
